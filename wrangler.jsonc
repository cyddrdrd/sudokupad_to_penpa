{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sudokupad-to-penpa-log",
  "account_id": "13612738fe64d030dc23f7e3b06de377",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {"enabled": false},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sudokupad-to-penpa-usage",
    "database_id": "0c21c8b7-274e-4b2d-b10e-13a0ca17abba"
  }],
  // Initialize/update with: npx wrangler d1 migrations apply sudokupad-to-penpa-usage --remote --env=""
  // Then publish with: npx wrangler deploy --keep-vars --env=""
  "env": {
    "development": {
      "vars": {"ALLOWED_ORIGINS": "http://localhost:8766,http://127.0.0.1:8766,http://localhost:8787,http://127.0.0.1:8787"},
      "d1_databases": [{
        "binding": "DB",
        "database_name": "sudokupad-to-penpa-usage-dev",
        "database_id": "local-development"
      }]
    }
  }
}
