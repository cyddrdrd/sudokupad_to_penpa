{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sudokupad-to-penpa-log",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {"enabled": false},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sudokupad-to-penpa-usage",
    // Set this after: npx wrangler d1 create sudokupad-to-penpa-usage
    "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID"
  }],
  // Initialize with: npx wrangler d1 execute sudokupad-to-penpa-usage --remote --file=schema.sql
  // Then publish with: npx wrangler deploy
  "env": {
    "development": {
      "vars": {"ALLOWED_ORIGINS": "http://localhost:8766,http://127.0.0.1:8766,http://localhost:8787,http://127.0.0.1:8787"},
      "d1_databases": [{
        "binding": "DB",
        "database_name": "sudokupad-to-penpa-usage-dev",
        "database_id": "local-development"
      }]
    }
  }
}
